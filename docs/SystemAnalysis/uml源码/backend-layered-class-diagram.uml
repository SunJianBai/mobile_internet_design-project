@startuml
title CampusCompanionBackend Layered Class Diagram

skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
hide empty members

left to right direction

package "controller" {
  class BaseController {
    --
    + success(data): ApiResponse
    + success(message, data): ApiResponse
    + error(code, message): ApiResponse
    + error(message): ApiResponse
  }

  class AuthController {
    - authService: AuthService
    - verifyService: VerifyService
    --
    + login(request): ApiResponse<LoginResponse>
    + register(request): ApiResponse<Long>
    + refreshToken(request): ApiResponse<String>
    + logout(userId): ApiResponse<Void>
    + verifyEmailForReset(request): ApiResponse<ForgotPasswordVerifyEmailResponse>
    + sendResetCode(request): ApiResponse<Void>
    + verifyResetCode(request): ApiResponse<Void>
    + resetPassword(request): ApiResponse<Void>
  }

  class UserController {
    - userService: UserService
    --
    + getUserInfo(userId): ApiResponse<UserInfoResponse>
    + updateUserInfo(userId, request): ApiResponse<UserInfoResponse>
    + changePassword(userId, request): ApiResponse<Void>
    + uploadAvatar(userId, avatar): ApiResponse<String>
    + searchUsers(keyword, page, size): ApiResponse<Object>
    + resetPasswordByCode(code, password): ApiResponse<Void>
  }

  class OrderController {
    - orderService: OrderService
    --
    + createOrder(request): ApiResponse<Long>
    + getOrders(page, size, status, activityType, campus): ApiResponse<Object>
    + getMyOrders(userId, page, size): ApiResponse<Object>
    + getOrderDetail(orderId): ApiResponse<Object>
    + updateOrder(orderId, request): ApiResponse<Long>
    + deleteOrder(orderId): ApiResponse<Void>
    + completeOrder(orderId): ApiResponse<Void>
    + applyOrder(orderId, request): ApiResponse<Long>
    + cancelApply(orderId): ApiResponse<Void>
    + getApplications(orderId): ApiResponse<Object>
    + auditApply(applyId, request): ApiResponse<Void>
    + acceptOrder(orderId, request): ApiResponse<Void>
    + sendOrderMessage(orderId, request): ApiResponse<Long>
    + getOrderMessages(orderId, page, size): ApiResponse<Object>
  }

  class ContentController {
    - contentService: ContentService
    --
    + createContent(request): ApiResponse<Long>
    + getContents(page, size, type): ApiResponse<Object>
    + getContentDetail(contentId): ApiResponse<Object>
    + updateContent(contentId, request): ApiResponse<Long>
    + deleteContent(contentId): ApiResponse<Void>
    + uploadMedia(contentId, media): ApiResponse<String>
    + getMedias(contentId): ApiResponse<Object>
    + createComment(contentId, request): ApiResponse<Long>
    + getComments(contentId, page, size): ApiResponse<Object>
    + deleteComment(commentId): ApiResponse<Void>
    + likeContent(contentId): ApiResponse<Object>
    + getLikes(contentId): ApiResponse<Object>
    + searchByKeyword(keyword, page, size, type): ApiResponse<Object>
  }

  class AgentController {
    - agentService: AgentService
    - agentStreamService: AgentStreamService
    --
    + createConversation(userId): ApiResponse<Map<String,Object>>
    + listConversations(userId): ApiResponse<List<Map<String,Object>>>
    + getMessages(userId, cid): ApiResponse<List<Map<String,Object>>>
    + deleteConversation(userId, cid): ApiResponse<Void>
    + sendMessage(userId, cid, body): ApiResponse<Map<String,Object>>
    + streamMessage(userId, cid, body): SseEmitter
    + getMemories(userId): ApiResponse<List<Map<String,Object>>>
    + deleteMemory(userId, memId): ApiResponse<Void>
    - toConversationMap(conv): Map<String,Object>
    - toMessageMap(msg): Map<String,Object>
    - toMemoryMap(mem): Map<String,Object>
  }

  class AdminController {
    - adminService: AdminService
    --
    + getUsers(page, size, userType): ApiResponse<Object>
    + updateUserType(userId, userType): ApiResponse<Void>
    + manageOrder(orderId, status): ApiResponse<Void>
    + deleteContent(contentId): ApiResponse<Void>
    + getStatistics(): ApiResponse<Object>
  }

  class FileController {
    - fileService: FileService
    --
    + uploadImage(image): ApiResponse<String>
    + uploadVideo(video): ApiResponse<String>
    + deleteFile(fileUrl): ApiResponse<Boolean>
    + deleteFile(pmid): ApiResponse<Boolean>
  }

  class VerifyController {
    - verifyService: VerifyService
    --
    + verifyEmail(email): ApiResponse<Void>
  }
}

package "service" {
  interface AuthService {
    --
    + login(request): LoginResponse
    + register(request): Long
    + refreshToken(refreshToken): String
    + logout(userId): void
    + verifyEmailForReset(request): ForgotPasswordVerifyEmailResponse
    + verifyResetCode(request): void
    + resetPassword(request): void
  }

  interface UserService {
    --
    + getUserInfo(userId): UserInfoResponse
    + updateUserInfo(userId, request): UserInfoResponse
    + changePassword(userId, request): void
    + uploadAvatar(userId, avatar): String
    + searchUsers(keyword, page, size): Object
    + resetPassword(): void
  }

  interface OrderService {
    --
    + createOrder(request): Long
    + getOrders(page, size, status, activityType, campus): Object
    + getMyOrders(userId, page, size): Object
    + getOrderDetail(orderId): Object
    + updateOrder(orderId, request): Long
    + deleteOrder(orderId): void
    + completeOrder(orderId): void
    + applyOrder(orderId, request): Long
    + cancelApply(orderId): void
    + getApplications(orderId): Object
    + auditApply(applyId, status): void
    + acceptOrder(orderId, accepterId): void
    + sendOrderMessage(orderId, content): Long
    + getOrderMessages(orderId, page, size): Object
  }

  interface ContentService {
    --
    + createContent(request): Long
    + getContents(page, size, type): Object
    + getContentDetail(contentId): Object
    + updateContent(contentId, request): Long
    + deleteContent(contentId): void
    + uploadMedia(contentId, media): String
    + getMedias(contentId): List<PostMedia>
    + createComment(contentId, request): Long
    + getComments(contentId, page, size): Object
    + deleteComment(commentId): void
    + likeContent(contentId): Map<String,Object>
    + getLikes(contentId): Object
    + searchByKeyword(keyword, page, size, type): Object
  }

  interface AgentService {
    --
    + createConversation(userId): AiConversation
    + listConversations(userId): List<AiConversation>
    + getMessages(userId, conversationId): List<AiMessage>
    + deleteConversation(userId, conversationId): void
    + sendMessage(userId, conversationId, userMessage): AiMessage
    + getMemories(userId): List<AiMemory>
    + deleteMemory(userId, memoryId): void
  }

  interface AdminService {
    --
    + getUsers(page, size, userType): Object
    + updateUserType(userId, userType): void
    + manageOrder(orderId, status): void
    + deleteContent(contentId): void
    + getStatistics(): Object
  }

  interface FileService {
    --
    + uploadImage(image): String
    + uploadVideo(video): String
    + deleteFile(fileUrl): boolean
    + deleteFile(pmid): boolean
  }

  interface VerifyService {
    --
    + verifyEmail(email, type): void
  }
}

package "service.impl" {
  class AuthServiceImpl {
    - userRepository: UserRepository
    - verifyCodeRecordRepository: VerifyCodeRecordRepository
    - passwordEncoder: PasswordEncoder
    --
    + login(request): LoginResponse
    + register(request): Long
    + refreshToken(refreshToken): String
    + logout(userId): void
    + verifyEmailForReset(request): ForgotPasswordVerifyEmailResponse
    + verifyResetCode(request): void
    + resetPassword(request): void
  }

  class UserServiceImpl {
    - userRepository: UserRepository
    - passwordEncoder: PasswordEncoder
    --
    + getUserInfo(userId): UserInfoResponse
    + updateUserInfo(userId, request): UserInfoResponse
    + changePassword(userId, request): void
    + uploadAvatar(userId, avatar): String
    + searchUsers(keyword, page, size): Object
    + resetPassword(): void
    - getUserById(userId): User
    - convertToUserInfoResponse(user): UserInfoResponse
    - getCurrentUserIdOrThrow(): Long
  }

  class OrderServiceImpl {
    - orderRepository: OrderRepository
    - userRepository: UserRepository
    - orderApplyRepository: OrderApplyRepository
    - orderMessageRepository: OrderMessageRepository
    - orderAcceptRepository: OrderAcceptRepository
    - formatter: DateTimeFormatter
    --
    + createOrder(request): Long
    + getOrders(page, size, status, activityType, campus): Object
    + getMyOrders(userId, page, size): Object
    + getOrderDetail(orderId): Object
    + updateOrder(orderId, request): Long
    + deleteOrder(orderId): void
    + completeOrder(orderId): void
    + applyOrder(orderId, request): Long
    + cancelApply(orderId): void
    + getApplications(orderId): Object
    + auditApply(applyId, status): void
    + acceptOrder(orderId, accepterId): void
    + sendOrderMessage(orderId, content): Long
    + getOrderMessages(orderId, page, size): Object
    - getCurrentUserIdOrThrow(): Long
    - manualPagination(orders, page, size): Object
    - isOrderPendingOrInProcess(orderId, order): void
    - convertToOrderVO(order): Map<String,Object>
    - convertToOrderApplyVO(orderApply): Map<String,Object>
    - convertToOrderMessageVO(message): Map<String,Object>
  }

  class ContentServiceImpl {
    - postRepository: PostRepository
    - postLikeRepository: PostLikeRepository
    - userRepository: UserRepository
    - orderRepository: OrderRepository
    - postMediaRepository: PostMediaRepository
    - fileService: FileService
    --
    + createContent(request): Long
    + getContents(page, size, type): Object
    + getContentDetail(contentId): Object
    + updateContent(contentId, request): Long
    + deleteContent(contentId): void
    + uploadMedia(contentId, media): String
    + getMedias(contentId): List<PostMedia>
    + createComment(contentId, request): Long
    + getComments(contentId, page, size): Object
    + deleteComment(commentId): void
    + likeContent(contentId): Map<String,Object>
    + getLikes(contentId): Object
    + searchByKeyword(keyword, page, size, type): Object
    - getCurrentUserIdOrThrow(): Long
    - getCurrentUserIdOrNull(): Long
    - deleteCommentRecursive(comment): void
    - getPostById(postId): Post
    - getUserById(userId): User
    - getOrderById(orderId): Order
    - convertToContentVO(post): Map<String,Object>
    - convertToContentDetailVO(post): Map<String,Object>
    - buildCommentNode(comment, parentId): Map<String,Object>
  }

  class AgentServiceImpl {
    - conversationRepository: AiConversationRepository
    - messageRepository: AiMessageRepository
    - memoryRepository: AiMemoryRepository
    - userRepository: UserRepository
    - pythonAgentClient: PythonAgentClient
    - MAX_HISTORY_MESSAGES: int
    --
    + createConversation(userId): AiConversation
    + listConversations(userId): List<AiConversation>
    + getMessages(userId, conversationId): List<AiMessage>
    + deleteConversation(userId, conversationId): void
    + sendMessage(userId, conversationId, userMessage): AiMessage
    + getMemories(userId): List<AiMemory>
    + deleteMemory(userId, memoryId): void
    + extractMemoryAsync(user, userMessage, assistantReply): void
  }

  class AgentStreamService {
    - conversationRepository: AiConversationRepository
    - messageRepository: AiMessageRepository
    - userRepository: UserRepository
    - agentService: AgentServiceImpl
    - pythonAgentClient: PythonAgentClient
    - executor: ExecutorService
    --
    + streamMessage(userId, conversationId, userMessage): SseEmitter
  }

  class AdminServiceImpl {
    - userRepository: UserRepository
    - orderRepository: OrderRepository
    - postRepository: PostRepository
    --
    + getUsers(page, size, userType): Object
    + updateUserType(userId, userType): void
    + manageOrder(orderId, status): void
    + deleteContent(contentId): void
    + getStatistics(): Object
    - convertToUserInfo(user): Map<String,Object>
  }

  class FileServiceImpl {
    - postMediaRepository: PostMediaRepository
    - baseUploadDir: String
    --
    + uploadImage(image): String
    + uploadVideo(video): String
    + deleteFile(fileUrl): boolean
    + deleteFile(pmid): boolean
    - uploadFile(file, uploadDir, fileType): String
  }

  class VerifyServiceImpl {
    - mailSender: JavaMailSender
    - verifyCodeRecordRepository: VerifyCodeRecordRepository
    - passwordEncoder: PasswordEncoder
    - fromEmail: String
    - EXPIRE_MINUTES: int
    --
    + verifyEmail(email, type): void
  }

  class PythonAgentClient {
    - memoryRepository: AiMemoryRepository
    - objectMapper: ObjectMapper
    - pythonBaseUrl: String
    - httpClient: HttpClient
    --
    + chat(user, history, message): Map<String,Object>
    + streamChat(user, history, message, onDelta, onToolCall, onDone, onError): void
    + extractMemory(userMessage, assistantReply): List<Map<String,String>>
    - buildRequestBody(user, history, message): Map<String,Object>
  }
}

package "repository" {
  interface UserRepository {
    --
    + findByEmail(email): Optional<User>
    + findByUserType(userType): Iterable<User>
    + findByNicknameContaining(rule): Iterable<User>
    + existsByEmail(email): boolean
  }

  interface OrderRepository {
    --
    + findByUser(user): List<Order>
    + findByStatus(status): List<Order>
    + findByCampusAndActivityTypeAndStatus(campus, type, status): List<Order>
    + findByStartTimeBetween(startTime, endTime): List<Order>
    + findExpiredOrders(status, expiredTime): List<Order>
    + findByUserAndStatus(user, status): List<Order>
  }

  interface OrderApplyRepository {
    --
    + findByOrderAndUser(order, user): Optional<OrderApply>
    + findByOrder(order): List<OrderApply>
    + findByUser(user): List<OrderApply>
    + findByOrderAndStatus(order, status): List<OrderApply>
    + existsByOrderAndUser(order, user): boolean
  }

  interface OrderAcceptRepository {
    --
    + findByOrder(order): List<OrderAccept>
    + findByAccepter(accepter): List<OrderAccept>
    + existsByOrder(order): boolean
  }

  interface OrderMessageRepository {
    --
    + findByOrderOrderByCreatedAtAsc(order): List<OrderMessage>
    + findBySenderAndReceiverAndOrderOrderByCreatedAtAsc(sender, receiver, order): List<OrderMessage>
    + findByReferenceMessage(referenceMessage): List<OrderMessage>
  }

  interface PostRepository {
    --
    + findByUserAndTypeAndStatus(user, type, status): List<Post>
    + findByParentPostAndTypeAndStatusOrderByCreatedAtDesc(parentPost, type, status): List<Post>
    + findByOrderAndStatus(order, status): List<Post>
    + findByTypeAndStatusOrderByCreatedAtDesc(type, status): List<Post>
    + findByContentContainingAndTypeAndStatusOrderByCreatedAtDesc(keyword, type, status): List<Post>
  }

  interface PostLikeRepository {
    --
    + findByPost(post): List<PostLike>
    + existsByPostAndUser(post, user): boolean
    + findByUser(user): List<PostLike>
    + findByPostAndUser(post, user): Optional<PostLike>
  }

  interface PostMediaRepository {
    --
    + findByPost(post): List<PostMedia>
    + findByPmid(pmid): PostMedia
  }

  interface AiConversationRepository {
    --
    + findByUserOrderByUpdatedAtDesc(user): List<AiConversation>
    + findByCidAndUser(cid, user): Optional<AiConversation>
    + deleteByUserAndCid(user, cid): void
  }

  interface AiMessageRepository {
    --
    + findByConversationOrderByCreatedAtAsc(conversation): List<AiMessage>
    + deleteByConversation(conversation): void
  }

  interface AiMemoryRepository {
    --
    + findByUserOrderByUpdatedAtDesc(user): List<AiMemory>
    + findByUserAndCategory(user, category): List<AiMemory>
  }

  interface VerifyCodeRecordRepository {
    --
    + findFirstByEmailAndTypeAndStatusOrderByCreatedAtDesc(email, type, status): Optional<VerifyCodeRecord>
  }
}

package "dto.request" {
  class LoginRequest {
    - identifier: String
    - password: String
    --
    + getters/setters()
  }

  class RefreshTokenRequest {
    - refreshToken: String
    --
    + getters/setters()
  }

  class RegisterRequest {
    - email: String
    - verifycode: String
    - password: String
    - nickname: String
    - studentId: String
    --
    + getters/setters()
  }

  class ForgotPasswordVerifyEmailRequest {
    - email: String
    --
    + getters/setters()
  }

  class ForgotPasswordVerifyCodeRequest {
    - email: String
    - verifyCode: Integer
    --
    + getters/setters()
  }

  class ForgotPasswordResetPasswordRequest {
    - email: String
    - verifyCode: Integer
    - newPassword: String
    --
    + getters/setters()
  }

  class ChangePasswordRequest {
    - oldPassword: String
    - newPassword: String
    --
    + getters/setters()
  }

  class UpdateUserRequest {
    - nickname: String
    - avatarUrl: String
    - signature: String
    --
    + getters/setters()
  }

  class CreateOrderRequest {
    - activityType: ActivityType
    - genderRequire: GenderRequire
    - campus: Campus
    - location: String
    - startTime: String
    - note: String
    - maxPeople: Integer
    --
    + getters/setters()
  }

  class ApplyOrderRequest {
    - message: String
    --
    + getters/setters()
  }

  class AcceptOrderRequest {
    - accepterId: Long
    --
    + getters/setters()
  }

  class AuditApplyRequest {
    - status: ApplyStatus
    --
    + getters/setters()
  }

  class SendOrderMessageRequest {
    - content: String
    --
    + getters/setters()
  }

  class CreateContentRequest {
    - content: String
    - mediaType: MediaType
    - orderId: Long
    --
    + getters/setters()
  }

  class CreateCommentRequest {
    - content: String
    - parentId: Long
    --
    + getters/setters()
  }
}

package "dto.response" {
  class ApiResponse~T~ {
    - code: Integer
    - message: String
    - data: T
    - timestamp: Long
    --
    + success(data): ApiResponse<T>
    + success(message, data): ApiResponse<T>
    + error(code, message): ApiResponse<T>
    + error(message): ApiResponse<T>
  }

  class LoginResponse {
    - token: String
    - userInfo: UserInfoResponse
    --
    + getters/setters()
  }

  class ForgotPasswordVerifyEmailResponse {
    - emailMasked: String
    --
    + getters/setters()
  }

  class UserInfoResponse {
    - id: Long
    - email: String
    - nickname: String
    - avatarUrl: String
    - userType: Integer
    - signature: String
    - createdAt: String
    --
    + getters/setters()
  }

  class PageResponse~T~ {
    - list: List<T>
    - total: Long
    - page: Integer
    - size: Integer
    --
    + getters/setters()
  }
}

package "entity refs" {
  class User
  class Order
  class OrderApply
  class OrderAccept
  class OrderMessage
  class Post
  class PostLike
  class PostMedia
  class AiConversation
  class AiMessage
  class AiMemory
  class VerifyCodeRecord
}

package "enum refs" {
  enum ActivityType
  enum Campus
  enum OrderStatus
  enum ApplyStatus
  enum GenderRequire
  enum MediaType
}

BaseController <|-- AuthController
BaseController <|-- UserController
BaseController <|-- OrderController
BaseController <|-- ContentController
BaseController <|-- AgentController
BaseController <|-- AdminController
BaseController <|-- FileController
BaseController <|-- VerifyController

BaseController ..> ApiResponse

AuthController --> AuthService
AuthController --> VerifyService
AuthController ..> LoginRequest
AuthController ..> RegisterRequest
AuthController ..> RefreshTokenRequest
AuthController ..> ForgotPasswordVerifyEmailRequest
AuthController ..> ForgotPasswordVerifyCodeRequest
AuthController ..> ForgotPasswordResetPasswordRequest
AuthController ..> LoginResponse
AuthController ..> ForgotPasswordVerifyEmailResponse

UserController --> UserService
UserController ..> UpdateUserRequest
UserController ..> ChangePasswordRequest
UserController ..> UserInfoResponse

OrderController --> OrderService
OrderController ..> CreateOrderRequest
OrderController ..> ApplyOrderRequest
OrderController ..> AcceptOrderRequest
OrderController ..> AuditApplyRequest
OrderController ..> SendOrderMessageRequest

ContentController --> ContentService
ContentController ..> CreateContentRequest
ContentController ..> CreateCommentRequest

AgentController --> AgentService
AgentController --> AgentStreamService
AdminController --> AdminService
FileController --> FileService
VerifyController --> VerifyService

AuthServiceImpl ..|> AuthService
UserServiceImpl ..|> UserService
OrderServiceImpl ..|> OrderService
ContentServiceImpl ..|> ContentService
AgentServiceImpl ..|> AgentService
AdminServiceImpl ..|> AdminService
FileServiceImpl ..|> FileService
VerifyServiceImpl ..|> VerifyService

ContentServiceImpl --> FileService
AgentServiceImpl --> PythonAgentClient
AgentStreamService --> PythonAgentClient
AgentStreamService --> AgentServiceImpl

AuthServiceImpl --> UserRepository
AuthServiceImpl --> VerifyCodeRecordRepository
UserServiceImpl --> UserRepository
OrderServiceImpl --> OrderRepository
OrderServiceImpl --> UserRepository
OrderServiceImpl --> OrderApplyRepository
OrderServiceImpl --> OrderMessageRepository
OrderServiceImpl --> OrderAcceptRepository
ContentServiceImpl --> PostRepository
ContentServiceImpl --> PostLikeRepository
ContentServiceImpl --> UserRepository
ContentServiceImpl --> OrderRepository
ContentServiceImpl --> PostMediaRepository
AgentServiceImpl --> AiConversationRepository
AgentServiceImpl --> AiMessageRepository
AgentServiceImpl --> AiMemoryRepository
AgentServiceImpl --> UserRepository
AgentStreamService --> AiConversationRepository
AgentStreamService --> AiMessageRepository
AgentStreamService --> UserRepository
AdminServiceImpl --> UserRepository
AdminServiceImpl --> OrderRepository
AdminServiceImpl --> PostRepository
FileServiceImpl --> PostMediaRepository
VerifyServiceImpl --> VerifyCodeRecordRepository
PythonAgentClient --> AiMemoryRepository

UserRepository ..> User
OrderRepository ..> Order
OrderApplyRepository ..> OrderApply
OrderAcceptRepository ..> OrderAccept
OrderMessageRepository ..> OrderMessage
PostRepository ..> Post
PostLikeRepository ..> PostLike
PostMediaRepository ..> PostMedia
AiConversationRepository ..> AiConversation
AiMessageRepository ..> AiMessage
AiMemoryRepository ..> AiMemory
VerifyCodeRecordRepository ..> VerifyCodeRecord

LoginResponse --> UserInfoResponse

CreateOrderRequest ..> ActivityType
CreateOrderRequest ..> GenderRequire
CreateOrderRequest ..> Campus
AuditApplyRequest ..> ApplyStatus
CreateContentRequest ..> MediaType
OrderService ..> OrderStatus
OrderService ..> ActivityType
OrderService ..> Campus

note bottom of AgentStreamService
  This class does not implement an interface.
  It coordinates SSE streaming with the Python agent
  and persists incremental AI conversation messages.
end note

note bottom of PageResponse~T~
  PageResponse exists in source code as a reusable
  pagination DTO, even when some services currently
  return Object wrappers instead of the generic type directly.
end note

@enduml
