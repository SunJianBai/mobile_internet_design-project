# Copy this file to .env.prod on the server and fill in real values.

COMPOSE_PROJECT_NAME=campushub

# Release image tag. Usually set by CI/CD to a short Git commit SHA.
CAMPUSHUB_IMAGE_TAG=latest

# Frontend container bind address. Caddy/Nginx on the host proxies /CampusHub to this port.
FRONTEND_HTTP_PORT=127.0.0.1:18080

# Public base URL used by smoke-test scripts.
PUBLIC_BASE_URL=https://sun227454.online/CampusHub

# MySQL
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=campus_companion

# Spring Boot backend
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_JPA_HIBERNATE_DDL_AUTO=update
JWT_SECRET=change-me-to-a-long-random-secret

# Mail service. Required for email verification flows.
SPRING_MAIL_HOST=smtp.163.com
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Python Agent / LLM
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3-32B
AMAP_MCP_URL=
